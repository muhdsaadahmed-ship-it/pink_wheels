# --- Database (PostgreSQL) ---
# For local development without Docker you may temporarily use:
#   sqlite:///./pink_wheels.db
# PostgreSQL is the required production/development database:
DATABASE_URL=postgresql+psycopg://pinkwheels:pinkwheels@localhost:5432/pink_wheels

# --- Security ---
JWT_SECRET=generate-a-long-random-string-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- OTP provider (leave blank in development; OTPs are logged instead) ---
OTP_PROVIDER_API_KEY=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# --- Frontend build-time ---
VITE_API_URL=http://localhost:8000
